<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  
  <!-- Remotes -->
  <remote name="bldfhds"
          fetch="https://github.com/bloodofhadesx/" />
  
  <remote name="lindroid"
          fetch="https://github.com/Linux-on-droid/" />
  
  <remote name="github"
          fetch="https://github.com/" />
  
  <remote name="gitlab"
          fetch="https://gitlab.com/" />

  <!-- Remove Projects -->
  <remove-project name="LineageOS/android_hardware_qcom_display" />
  <remove-project name="LineageOS/android_frameworks_base" />
  <remove-project name="LineageOS/android_frameworks_native" />
  <remove-project name="LineageOS/android_system_core" />

  <!-- Device Tree -->
  <project path="device/xiaomi/laurel_sprout"
           name="device_xiaomi_laurel_sprout"
           remote="bldfhds"
           revision="ldroid" />

  <!-- Vendor Blobs -->
  <project path="vendor/xiaomi/laurel_sprout"
           name="vendor_xiaomi_laurel_sprout"
           remote="bldfhds"
           revision="ldroid" />

  <!-- Kernel Source -->
  <project path="kernel/xiaomi/laurel_sprout"
           name="kernel_xiaomi_laurel_sprout"
           remote="bldfhds"
           revision="lotus" />

  <!-- Lindroid -->
  <project path="vendor/lindroid"
           name="vendor_lindroid"
           remote="bldfhds"
           revision="ldroid" />
  
  <project path="libhybris"
           name="libhybris"
           remote="lindroid"
           revision="lindroid-21" />
  
  <project path="external/lxc"
           name="external_lxc"
           remote="lindroid"
           revision="lindroid-21" />

  <!-- Frameworks -->
  <project path="frameworks/base"
           name="android_frameworks_base"
           remote="bldfhds"
           revision="ldroid"
           groups="pdk-cw-fs,pdk-fs,sysui-studio" />
  
  <project path="frameworks/native"
           name="android_frameworks_native"
           remote="bldfhds"
           revision="ldroid"
           groups="pdk" />

  <!-- System -->
  <project path="system/core"
           name="android_system_core"
           remote="bldfhds"
           revision="ldroid"
           groups="pdk" />

</manifest>
